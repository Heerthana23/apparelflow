
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUTTING_SUPERVISOR
  CUTTING_VERIFIER
  SEWING_SUPERVISOR
}

enum OrderStatus {
  CUTTING_IN_PROGRESS
  PENDING_VERIFICATION
  REJECTED
  VERIFIED
  SEWING
}

enum VerificationStatus {
  GREEN
  YELLOW
  RED
}

enum VerificationDecision {
  APPROVED
  REJECTED
}

model User {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  passwordHash     String
  role             Role
  fullName         String
  createdAt        DateTime @default(now())

  orders           CuttingOrder[]
  verificationLogs VerificationLog[]
}

model Recipe {
  id             Int     @id @default(autoincrement())
  recipeCode     String  @unique
  name           String
  category       String
  stdFabricYards Float
  wastageCap     Float

  components RecipeComponent[]
  orders     CuttingOrder[]
}

model RecipeComponent {
  id               Int      @id @default(autoincrement())
  recipeId         Int
  componentName    String
  piecesPerGarment Int
  imageUrl         String?

  recipe            Recipe             @relation(fields: [recipeId], references: [id])
  verificationItems VerificationItem[]
}

model CuttingOrder {
  id              Int         @id @default(autoincrement())
  orderNo         String      @unique
  recipeId        Int
  targetQty       Int
  fabricRollId    String
  actualFabricYds Float
  status          OrderStatus @default(CUTTING_IN_PROGRESS)
  createdBy       Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  recipe            Recipe             @relation(fields: [recipeId], references: [id])
  creator           User               @relation(fields: [createdBy], references: [id])
  verificationItems VerificationItem[]
  verificationLogs  VerificationLog[]
}

model VerificationItem {
  id          Int                @id @default(autoincrement())
  orderId     Int
  componentId Int
  expectedQty Int
  actualQty   Int
  status      VerificationStatus

  order     CuttingOrder    @relation(fields: [orderId], references: [id])
  component RecipeComponent @relation(fields: [componentId], references: [id])
}

model VerificationLog {
  id            Int                  @id @default(autoincrement())
  orderId       Int
  verifierId    Int
  decision      VerificationDecision
  rejectionNote String?
  wastagePct    Float
  timestamp     DateTime             @default(now())

  order    CuttingOrder @relation(fields: [orderId], references: [id])
  verifier User         @relation(fields: [verifierId], references: [id])
}
